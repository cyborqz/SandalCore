build/
out/
dist/
cmake-build-*/
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.idb

# ──────────────────────────────────────────────────────────────────────────
# vcpkg & Dependencies
# ──────────────────────────────────────────────────────────────────────────
vcpkg_installed/
vcpkg-manifest-install.log
_deps/
/third_party/CUE4Parse/
/tools/mapc/bin/
/tools/mapc/obj/

# ──────────────────────────────────────────────────────────────────────────
# CMake
# ──────────────────────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CMakeSettings.json
Testing/

# ──────────────────────────────────────────────────────────────────────────
# Visual Studio / MSBuild
# ──────────────────────────────────────────────────────────────────────────
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.VC.db
*.ipch
.vs/
x64/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/

# ──────────────────────────────────────────────────────────────────────────
# IDEs & Editors
# ──────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
.clangd/

# ──────────────────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# ──────────────────────────────────────────────────────────────────────────
# Runtime data & Logs
# ──────────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
capture-*.jsonl
emulator.db*
active_account.kv
characters.json

# ──────────────────────────────────────────────────────────────────────────
# Local configs & Secrets
# ──────────────────────────────────────────────────────────────────────────
config/local.json
config/*.local.json
.env
.env.*
*.secret
*.token
ics_auth_token.txt

# ──────────────────────────────────────────────────────────────────────────
# TLS / Certificates (Do not commit private keys or generated certs)
# ──────────────────────────────────────────────────────────────────────────
certs/*.key
certs/*.pem
certs/*.crt
certs/*.srl
certs/*.bak-*
# Allow public CA bundle to ship
!certs/amazon_ca_bundle.pem
!certs/README.md

# ──────────────────────────────────────────────────────────────────────────
# Experimental / Debug Dumps (outside captures/)
# ──────────────────────────────────────────────────────────────────────────
dump_*.bin
capture_*.bin
Dumped*.txt

# ──────────────────────────────────────────────────────────────────────────
# Game data and sources made by extract_game_data.bat from your own game install (dist/content is under dist/; nothing of it is committed)
/server/worldd/world/zoi_surface_table.h
/server/worldd/world/node_constants.h
/server/worldd/spawns/region_data.h
/server/worldd/spawns/garden_defs.h
/server/worldd/stats/testdata/corpus.txt
/server/worldd/tests/talent_fixture.sql
/server/worldd/tests/gear_fixture.h
/server/worldd/tests/tooltip_key.h
/services/internal/citynode/constants_gen.go
/tools/mapc/region_rects.tsv
/fixtures/region/riverlands_rects.json
/fixtures/region/riverlands_zoi_rects.json

